  "bugs": {
    "url": "https://github.com/naewatcharapong1996/rsvp-wd/issues"
  },
  "homepage": "https://github.com/naewatcharapong1996/rsvp-wd#readme",
  "dependencies": {
    "gsap": "^3.15.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
